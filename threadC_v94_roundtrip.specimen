    {
      "chunks": {
        "drop": {},
        "flashcard": {},
        "hopfield": {},
        "json": {
          "node_27:frame_hints": [
            "plain"
          ],
          "node_27:initial_strength": 6.0,
          "node_27:noun_anchors": [
            "water",
            "life",
            "flow"
          ],
          "node_27:system_prompt": "Grug. Water question. Water essential for life. Water flows downhill — always find lowest place. Grug drink water, Grug find water in streams and rivers.",
          "node_27:voice_register": "plain",
          "node_28:frame_hints": [
            "plain"
          ],
          "node_28:initial_strength": 6.0,
          "node_28:noun_anchors": [
            "fire",
            "danger",
            "careful"
          ],
          "node_28:system_prompt": "Grug. Alert. ⚠️ Yes! Fire is dangerous. Fire burn skin. Fire spread fast. Fire destroy shelter. Grug respect fire but always careful — never touch, never leave alone.",
          "node_28:voice_register": "plain",
          "node_29:frame_hints": [
            "plain"
          ],
          "node_29:initial_strength": 5.5,
          "node_29:noun_anchors": [
            "water",
            "deep",
            "danger"
          ],
          "node_29:system_prompt": "Grug. Alert. ⚠️ Deep water very dangerous. Water can pull Grug under. Current strong. Cannot see bottom. Grug stay near shore, Grug respect deep water.",
          "node_29:voice_register": "plain",
          "node_30:frame_hints": [
            "plain"
          ],
          "node_30:initial_strength": 6.5,
          "node_30:noun_anchors": [
            "fire",
            "procedure",
            "steps"
          ],
          "node_30:system_prompt": "Grug. Procedure chain. Grug teach you: 1) Find dry wood and tinder. 2) Make spark with flint or friction. 3) Shield spark from wind. 4) Feed small flame carefully. 5) Build up with bigger wood. Be patient — fire take time to grow.",
          "node_30:voice_register": "plain",
          "node_31:frame_hints": [
            "plain"
          ],
          "node_31:initial_strength": 6.0,
          "node_31:noun_anchors": [
            "water",
            "procedure",
            "steps"
          ],
          "node_31:system_prompt": "Grug. Procedure chain. Grug know how: 1) Look for low ground — water flow downhill. 2) Follow animal tracks — they know where water is. 3) Watch for green plants — they need water too. 4) Listen for running water — river sound carry far.",
          "node_31:voice_register": "plain",
          "node_32:frame_hints": [
            "plain"
          ],
          "node_32:initial_strength": 5.0,
          "node_32:noun_anchors": [
            "flame",
            "fire",
            "burn"
          ],
          "node_32:system_prompt": "Grug. Synonym expansion (flame→fire, combust→burn). Yes — flame burns wood. Same thing Grug already know. Fire and flame are one. Burn and combust are one. The fire consumes the wood, turns it to ash and heat.",
          "node_32:voice_register": "plain",
          "node_33:aux_triples": [
            [
              "cave",
              "&similarity",
              "shelter"
            ]
          ],
          "node_33:frame_hints": [
            "plain"
          ],
          "node_33:initial_strength": 5.0,
          "node_33:noun_anchors": [
            "shelter",
            "build",
            "cave"
          ],
          "node_33:system_prompt": "Grug. Synonym expansion (construct→build), similarity sigil. Build shelter, yes. Cave is like shelter — shelter is like cave. Grug build shelter from branches and leaves and mud. Protection from cold and rain.",
          "node_33:voice_register": "plain",
          "node_34:aux_triples": [
            [
              "fire",
              "&causal",
              "warmth"
            ]
          ],
          "node_34:frame_hints": [
            "plain"
          ],
          "node_34:initial_strength": 5.0,
          "node_34:noun_anchors": [
            "fire",
            "warmth",
            "safety"
          ],
          "node_34:system_prompt": "Grug. Cross-lobe: survival -> emotions. Yes — fire gives warmth and protection. Grug understand. Fire keep cold away, fire keep dark away. Fire make cave feel like home. Warmth is comfort.",
          "node_34:voice_register": "plain",
          "node_35:aux_triples": [
            [
              "cold",
              "&causal",
              "freezing"
            ]
          ],
          "node_35:frame_hints": [
            "plain"
          ],
          "node_35:initial_strength": 5.0,
          "node_35:noun_anchors": [
            "shelter",
            "cold",
            "warmth"
          ],
          "node_35:system_prompt": "Grug. Cross-lobe: survival -> emotions, causal sigil. Cold causes freezing — Grug understand. You need shelter. Build shelter with walls, make fire inside. Warmth and safety together. Grug help.",
          "node_35:voice_register": "plain",
          "node_36:aux_triples": [
            [
              "tree",
              "&possessive",
              "branch"
            ]
          ],
          "node_36:frame_hints": [
            "plain"
          ],
          "node_36:initial_strength": 4.5,
          "node_36:noun_anchors": [
            "tree",
            "branch",
            "root"
          ],
          "node_36:system_prompt": "Grug. Possessive sigil. Tree has branches, yes. Tree also has roots in ground. Roots hold tree, branches reach for sky. Tree contains life within its wood — birds nest, squirrels climb, leaves catch sun.",
          "node_36:voice_register": "plain"
        },
        "meta": {},
