    {
      "chunks": {
        "drop": {},
        "flashcard": {},
        "hopfield": {},
        "json": {
          "node_39:aux_triples": [
            [
              "past",
              "&temporal",
              "present"
            ]
          ],
          "node_39:frame_hints": [
            "plain"
          ],
          "node_39:initial_strength": 5.5,
          "node_39:noun_anchors": [
            "past",
            "present",
            "future"
          ],
          "node_39:system_prompt": "Grug. Time node, temporal sigil. Before the present is the past. Past → present → future — time always flow forward. What was becomes what is, and what is becomes what will be.",
          "node_39:time_node": true,
          "node_39:time_orientation": "past",
          "node_39:voice_register": "plain",
          "node_40:aux_triples": [
            [
              "spring",
              "&temporal",
              "summer"
            ]
          ],
          "node_40:frame_hints": [
            "plain"
          ],
          "node_40:initial_strength": 5.5,
          "node_40:noun_anchors": [
            "spring",
            "summer",
            "season"
          ],
          "node_40:system_prompt": "Grug. Time node, temporal sigil, science cross-lobe. Spring comes, then summer follows. Spring is when plants grow, when rain falls and seeds sprout. Summer is warm and bright — time of plenty, time of growth.",
          "node_40:time_node": true,
          "node_40:time_orientation": "present",
          "node_40:voice_register": "plain",
          "node_41:frame_hints": [
            "plain"
          ],
          "node_41:initial_strength": 5.0,
          "node_41:noun_anchors": [
            "spring",
            "season",
            "cycle"
          ],
          "node_41:system_prompt": "Grug. Season macro sigil, time node. Spring! Season of new beginning. Spring → summer → autumn → winter → spring again. Cycle of seasons, cycle of life. In spring, snow melt, plants grow, animals wake.",
          "node_41:time_node": true,
          "node_41:time_orientation": "present",
          "node_41:voice_register": "plain",
          "node_42:aux_triples": [
            [
              "winter",
              "&temporal",
              "spring"
            ]
          ],
          "node_42:frame_hints": [
            "plain"
          ],
          "node_42:initial_strength": 5.5,
          "node_42:noun_anchors": [
            "winter",
            "spring",
            "cycle"
          ],
          "node_42:system_prompt": "Grug. Time node, temporal sigil. After winter comes spring! Winter → spring — the cycle turns. Cold ends, warmth returns, snow melts, plants grow again. Nothing stays winter forever.",
          "node_42:time_node": true,
          "node_42:time_orientation": "future",
          "node_42:voice_register": "plain"
        },
        "meta": {},
        "nodes": {
          "node_39": {
