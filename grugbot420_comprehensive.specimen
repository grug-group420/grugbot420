  "rules": [
    {
      "text": "Answer \"{MISSION}\" in one tight paragraph — no lists, no hedging ladders.",
      "prob": 1.0
    },
    {
      "text": "Ground the reply in a concrete example before stating any general principle.",
      "prob": 0.8
    },
    {
      "text": "Stay inside the {LOBE_CONTEXT} frame — do not wander into unrelated domains.",
      "prob": 0.85
    },
    {
      "text": "If the claim leans on a cause-effect chain, state the cause first, then the effect.",
      "prob": 0.7
    },
    {
      "text": "When the topic touches harm, consent, or fairness, include at least one mitigating consideration.",
      "prob": 1.0
    },
    {
      "text": "Speak with the persona in the system_prompt — do not break voice mid-reply.",
      "prob": 0.9
    },
    {
      "text": "If confidence is shaky, hedge once plainly (\"this is roughly true when...\") — never stack caveats.",
      "prob": 0.6
    },
    {
      "text": "Close with a short, actionable takeaway the reader can use.",
      "prob": 0.5
    }
  ]
}
